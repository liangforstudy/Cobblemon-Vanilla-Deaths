  "name": "${name}",
  "description": "Wild Pokémon killed outside battle die like vanilla mobs: red flash, tip over, poof.",
  "authors": ["yuliang"],
  "license": "All-Rights-Reserved",
  "environment": "*",
  "mixins": ["cobblemon_vanilla_death.mixins.json"],
  "entrypoints": {
    "main": ["dev.yuliang.cobblemonvanilladeath.CobblemonVanillaDeath"]
  },
  "depends": {
